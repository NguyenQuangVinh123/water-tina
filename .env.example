# ==========================================================
# WaterTina - biến môi trường (sao chép thành .env.local để chạy)
# ==========================================================

# Chuỗi kết nối Neon (Postgres). Lấy trong Neon Dashboard -> Connection string
# bản có "pooled" hoặc thêm ?sslmode=require. Ví dụ:
# postgres://<user>:<pass>@ep-<xxx>-<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Key secret để đăng nhập admin (tự đặt, đoán khó). Ví dụ: my-super-secret-key
ADMIN_SECRET=
